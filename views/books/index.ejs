<h2>All books</h2>

<br />

<form action="/books" method="GET">
        <div>
                <label>Title</label>
                <input type="text" name="title" value="<%= searchOptions.title %>" />
                <button type="submit">Search</button>
        </div>
        <div>
                <label>Published Before</label>
                <input type="date" name="publishBefore" value="<%= searchOptions.publishBefore %>" />
        </div>
        <div>
                <label>Published After</label>
                <input type="date" name="publishAfter" value="<%= searchOptions.publishAfter %>" />
        </div>

        <button type="submit">Search</button>
</form>

<div>
        <% books.forEach( book=> { %>
                <div>
                        <%= book.title %>
                        <img src="<%= book.coverImagePath %>" alt="<%= book.title %>" style="max-width: 200px; width: 100%; height: auto;" />
                        <div>
                                <a href="/books/<%= book.id %>">View</a>
                                <a href="/books/<%= book.id %>/edit">Edit</a>
                                <%- include( '../partials/deleteForm', {
                                        url: `/books/${book.id}`,
                                } ) %>
                        </div>
                </div>
        <% }) %>
</div>
