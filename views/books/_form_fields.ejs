<div>
    <label for="title">Title</label>
    <input type="text" name="title" id="title" value="<%= book.title %>" />
</div>

<div>
    <label for="author_id">Author</label>
    <select name="author" id="author_id">
        <% authors.forEach(author => { %>
            <% if (book.author === author.id) { %>
                <option value="<%= author.id %>" selected><%= author.name %></option>
            <% } else { %>
                <option value="<%= author.id %>"><%= author.name %></option>
            <% } %>
        <% }) %>
    </select>
</div>

<div>
    <%
        const publishDate = !! book.publishDate ? new Date(book.publishDate).toISOString().split('T')[0] : '';
    %>
    <label for="publishDate">Publish Date</label>
    <input type="date" name="publishDate" id="publishDate" value="<%= publishDate %>" />
</div>

<div>
    <label for="pageCount">Page Count</label>
    <input type="number" name="pageCount" id="pageCount" value="<%= book.pageCount %>" />
</div>

<div>
    <label for="pageCount">Cover Image</label>
    <input type="file" name="coverImage" id="coverImage" />
</div>

<div>
    <label for="pageCount">Description</label>
    <textarea name="description" id="description" value="<%= book.description %>" ></textarea>
</div>
